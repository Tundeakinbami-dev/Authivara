# Authivara Environment Configuration Example
# Copy this file to .env before starting services

# Application Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_ORIGIN=http://localhost:4173
PUBLIC_API_URL=http://localhost:4000

# Next.js Public Client Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_ENABLED=true

# Database Persistence (PostgreSQL 14+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authivara?schema=public"

# Session & Privacy Cryptography
SESSION_COOKIE_NAME=authivara_session
SESSION_TTL_HOURS=168
PRIVACY_HASH_SECRET="replace-with-at-least-32-random-hex-chars-in-production"

# Private S3-Compatible Object Storage (Originals NEVER uploaded to blockchain)
STORAGE_BUCKET=authivara-vault-dev
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_KMS_KEY_ID=
MAX_UPLOAD_BYTES=2147483648

# Proof Anchoring Provider
# Options: 'sandbox' (local dev only), 'http' (managed Merkle anchor), 'stellar' (native Stellar Testnet)
ANCHOR_PROVIDER=stellar
ANCHOR_NETWORK="Stellar Testnet"
ANCHOR_EXPLORER_URL="https://stellar.expert/explorer/testnet/tx"

# Stellar Testnet Configuration (Required when ANCHOR_PROVIDER=stellar)
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Dedicated funded Testnet account (Fund using https://friendbot.stellar.org)
STELLAR_ANCHOR_ACCOUNT="GA..."
STELLAR_ANCHOR_SECRET="SA..."

# Optional Security Adapters
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
GOOGLE_CLIENT_ID=
