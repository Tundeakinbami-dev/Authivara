generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum ContentVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ProofStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  REVOKED
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  SCANNING
  CLEAN
  REJECTED
  CANCELLED
  EXPIRED
}

enum VerificationResult {
  MATCH
  NO_MATCH
  REVOKED
  ERROR
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
}

enum LicenseStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AuthProvider {
  PASSWORD
  MAGIC_LINK
  GOOGLE
  WALLET
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  name               String
  username           String               @unique
  avatarUrl          String?
  passwordHash       String?
  emailVerifiedAt    DateTime?
  mfaEnabled         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  creatorProfile     CreatorProfile?
  authAccounts       AuthAccount[]
  sessions           Session[]
  ownedOrganizations Organization[]       @relation("OrganizationOwner")
  memberships        OrganizationMember[]
  ownedContent       Content[]            @relation("ContentOwner")
  contentVersions    ContentVersion[]     @relation("VersionCreator")
  auditLogs          AuditLog[]
  createdLicenses    License[]            @relation("LicenseCreator")
}

model CreatorProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  displayName        String
  bio                String?
  website            String?
  country            String?
  socialLinks        Json?
  verificationStatus String   @default("UNVERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  slug           String               @unique
  ownerId        String               @db.Uuid
  subscriptionId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  owner          User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members        OrganizationMember[]
  content        Content[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Content {
  id             String             @id @default(uuid()) @db.Uuid
  ownerId        String             @db.Uuid
  organizationId String?            @db.Uuid
  title          String
  description    String?
  category       String
  fileName       String
  mimeType       String
  fileSize       BigInt
  storageKey     String?
  contentHash    String
  hashAlgorithm  String             @default("SHA-256")
  status         ContentStatus      @default(PROCESSING)
  visibility     ContentVisibility  @default(PRIVATE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation("ContentOwner", fields: [ownerId], references: [id])
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  versions       ContentVersion[]
  provenance     ProvenanceRecord[]
  certificates   Certificate[]
  licenses       License[]
  uploads        Upload[]

  @@index([ownerId, createdAt])
  @@index([organizationId, createdAt])
  @@index([contentHash])
}

model ContentVersion {
  id            String             @id @default(uuid()) @db.Uuid
  contentId     String             @db.Uuid
  versionNumber Int
  hash          String
  hashAlgorithm String             @default("SHA-256")
  storageKey    String?
  metadataHash  String?
  createdAt     DateTime           @default(now())
  createdBy     String             @db.Uuid
  content       Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  creator       User               @relation("VersionCreator", fields: [createdBy], references: [id])
  provenance    ProvenanceRecord[]

  @@unique([contentId, versionNumber])
  @@index([hash])
}

model ProvenanceRecord {
  id                 String              @id @default(uuid()) @db.Uuid
  contentId          String              @db.Uuid
  contentVersionId   String?             @db.Uuid
  proofId            String              @unique
  hash               String
  metadataHash       String?
  blockchainNetwork  String
  transactionHash    String?
  blockNumber        BigInt?
  anchoredAt         DateTime?
  submittedAt        DateTime?
  timestamp          DateTime            @default(now())
  status             ProofStatus         @default(PENDING)
  providerReceipt    Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  content            Content             @relation(fields: [contentId], references: [id], onDelete: Restrict)
  contentVersion     ContentVersion?     @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  certificate        Certificate?
  verificationEvents VerificationEvent[]

  @@index([hash, status])
  @@index([transactionHash])
}

model Upload {
  id           String       @id @default(uuid()) @db.Uuid
  contentId    String?      @db.Uuid
  ownerId      String       @db.Uuid
  storageKey   String       @unique
  fileName     String
  declaredMime String
  detectedMime String?
  fileSize     BigInt
  expectedHash String?
  uploadId     String?
  status       UploadStatus @default(PENDING)
  encryption   String       @default("aws:kms")
  expiresAt    DateTime
  completedAt  DateTime?
  scanResult   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  content      Content?     @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
}

model VerificationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  proofId       String
  submittedHash String
  result        VerificationResult
  requester     String?
  ipHash        String?
  userAgent     String?
  timestamp     DateTime           @default(now())
  provenance    ProvenanceRecord   @relation(fields: [proofId], references: [proofId], onDelete: Restrict)

  @@index([proofId, timestamp])
}

model Certificate {
  id                    String            @id @default(uuid()) @db.Uuid
  contentId             String            @db.Uuid
  provenanceRecordId    String            @unique @db.Uuid
  certificateNumber     String            @unique
  publicVerificationUrl String            @unique
  shareTokenHash        String            @unique
  generatedAt           DateTime          @default(now())
  expiresAt             DateTime?
  status                CertificateStatus @default(ACTIVE)
  content               Content           @relation(fields: [contentId], references: [id], onDelete: Restrict)
  provenance            ProvenanceRecord  @relation(fields: [provenanceRecordId], references: [id], onDelete: Restrict)
}

model License {
  id              String        @id @default(uuid()) @db.Uuid
  contentId       String        @db.Uuid
  createdBy       String        @db.Uuid
  licensor        String
  licensee        String
  licenseType     String
  startDate       DateTime
  endDate         DateTime?
  geographicScope String?
  usageScope      String
  exclusive       Boolean       @default(false)
  price           Decimal?      @db.Decimal(19, 4)
  currency        String?       @db.Char(3)
  status          LicenseStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  content         Content       @relation(fields: [contentId], references: [id], onDelete: Restrict)
  creator         User          @relation("LicenseCreator", fields: [createdBy], references: [id])

  @@index([contentId, status])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  resource       String
  resourceId     String?
  timestamp      DateTime @default(now())
  metadata       Json?
  previousHash   String?
  eventHash      String   @unique
  signature      String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([resource, resourceId])
}
